T = int(input())

for test_case in range(1, T + 1):
    answer = 0
    K, N, M = map(int, input().split())
    list_stop = list(map(int, input().split()))
    
    pos = 0
    K_cp = K
    cnt = 0
    
    for _ in range(N):
        
        if K_cp < 1:
            break
            
        if pos + K_cp >= N:
            answer = cnt
            break
        
        if pos + K_cp in list_stop:
            pos += K_cp
            K_cp = K
            cnt += 1
        else:
            K_cp -= 1
            
    
    print(f'#{test_case} {answer}')
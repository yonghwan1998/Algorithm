T = 10

for test_case in range(1, T + 1):
    answer = 0
    
    n = int(input())
    board = []
    
    for _ in range(n):
        board.append(list(map(int, input().split())))
        
    for col in range(n):
        found_A = False
        
        for row in range(n):
            if board[row][col] == 1:
                found_A = True
            elif board[row][col] == 2 and found_A:
                found_A = False
                answer += 1
                
    print(f'#{test_case} {answer}')

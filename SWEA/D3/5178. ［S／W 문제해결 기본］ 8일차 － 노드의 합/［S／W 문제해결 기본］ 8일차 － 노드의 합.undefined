T = int(input())

def insert_tree(idx):

    if idx > N:
        return 0

    if tree[idx] != 0:
        return tree[idx]

    tree[idx] = insert_tree(idx * 2) + insert_tree(idx * 2 + 1)

    return tree[idx]

for test_case in range(1, T + 1):
    N, M, L = list(map(int, input().split()))
    tree = [0] * (N + 1)

    for _ in range(M):
        node, number = map(int, input().split())
        tree[node] = number

    insert_tree(1)

    print(f'#{test_case} {tree[L]}')
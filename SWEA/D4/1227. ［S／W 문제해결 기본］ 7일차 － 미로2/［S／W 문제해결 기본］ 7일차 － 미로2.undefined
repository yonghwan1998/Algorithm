from collections import deque

dx = [-1, 1, 0, 0]
dy = [0, 0, -1, 1]

def search(x, y):
    global answer

    q = deque()

    q.append((x, y))
    visited[x][y] = 1

    while q:
        x, y = q.popleft()

        for i in range(4):
            nx = x + dx[i]
            ny = y + dy[i]

            if not (0 <= nx < 100 and 0 <= ny < 100):
                continue

            if arr[nx][ny] == 3:
                answer = 1
                return

            if arr[nx][ny] != 1 and visited[nx][ny] == 0:
                visited[nx][ny] = 1
                q.append((nx, ny))

for test_case in range(1, 11):
    input()

    answer = 0
    x, y = 1, 1

    arr = [list(map(int, input())) for _ in range(100)]
    visited = [[0] * 100 for _ in range(100)]

    search(x, y)

    print(f'#{test_case} {answer}')
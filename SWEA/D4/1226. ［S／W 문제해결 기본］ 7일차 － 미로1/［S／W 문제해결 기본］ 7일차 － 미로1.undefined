dx = [-1, 1, 0, 0]
dy = [0, 0, -1, 1]

def search(x, y):
    global answer

    for i in range(4):
        nx = dx[i] + x
        ny = dy[i] + y

        if arr[nx][ny] == 3:
            answer = 1
            return

        if not (0 <= nx < 16 and 0 <= ny < 16):
            continue

        if arr[nx][ny] != 1 and visited[nx][ny] == 0:
            visited[nx][ny] = 1
            search(nx, ny)

for test_case in range(1, 11):
    answer = 0
    input()

    x, y = 1, 1

    arr = [list(map(int, input())) for _ in range(16)]
    visited = [[0] * 16 for _ in range(16)]

    visited[x][y] = 1
    search(1, 1)

    print(f'#{test_case} {answer}')
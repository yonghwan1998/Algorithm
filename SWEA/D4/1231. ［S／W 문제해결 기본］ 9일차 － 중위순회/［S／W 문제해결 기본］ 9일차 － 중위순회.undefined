def inorder_traversal(idx):
    if idx <= N:
        inorder_traversal(idx * 2)
        print(tree[idx], end='')
        inorder_traversal(idx * 2 + 1)

for test_case in range(1, 11):
    N = int(input())
    tree = [0] * (N + 1)

    for _ in range(N):
        list_input = list(map(str, input().split()))
        tree[int(list_input[0])] = list_input[1]

    print(f'#{test_case}', end=' ')
    inorder_traversal(1)
    print()
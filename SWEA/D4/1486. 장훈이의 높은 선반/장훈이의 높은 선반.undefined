def dfs(index, height):
    global min_height

    if height >= B:
        min_height = min(height, min_height)
        return

    if index >= N:
        return

    dfs(index + 1, height + arr[index])
    dfs(index + 1, height)

T = int(input())

for test_case in range(1, T + 1):
    N, B = map(int, input().split())
    arr = list(map(int, input().split()))

    min_height = 10000 * N

    dfs(0, 0)

    print(f'#{test_case} {min_height - B}')